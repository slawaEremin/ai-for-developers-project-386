  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "unevaluatedProperties": {
          "not": {}
        }
      },
      "DurationMinutes": {
        "type": "integer",
        "format": "int32",
        "minimum": 1,
        "maximum": 540
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "unevaluatedProperties": {
          "not": {}
        }
      },
      "MeetingType": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "durationMinutes"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/MeetingTypeId"
          },
          "name": {
            "$ref": "#/components/schemas/MeetingTypeName"
          },
          "description": {
            "$ref": "#/components/schemas/MeetingTypeDescription"
          },
          "durationMinutes": {
            "$ref": "#/components/schemas/DurationMinutes"
          }
        },
        "unevaluatedProperties": {
          "not": {}
        }
      },
      "MeetingTypeDescription": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "description": "Обычный текст с внутренними переносами; края очищаются от пробелов."
      },
      "MeetingTypeId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$"
      },
      "MeetingTypeName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "description": "Однострочный обычный текст; края очищаются от пробелов, длина в Unicode."
      }
    }
