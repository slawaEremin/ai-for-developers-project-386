  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "unevaluatedProperties": {
          "not": {}
        }
      },
      "Availability": {
        "type": "object",
        "required": [
          "serverTime",
          "timeZone",
          "windowStartDate",
          "windowEndDate",
          "days"
        ],
        "properties": {
          "serverTime": {
            "type": "string",
            "format": "date-time"
          },
          "timeZone": {
            "type": "string",
            "enum": [
              "Europe/Moscow"
            ]
          },
          "windowStartDate": {
            "type": "string",
            "format": "date"
          },
          "windowEndDate": {
            "type": "string",
            "format": "date"
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailabilityDay"
            },
            "minItems": 14,
            "maxItems": 14
          }
        },
        "unevaluatedProperties": {
          "not": {}
        }
      },
      "AvailabilityDay": {
        "type": "object",
        "required": [
          "date",
          "slots"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailableSlot"
            }
          }
        },
        "unevaluatedProperties": {
          "not": {}
        }
      },
      "AvailableSlot": {
        "type": "object",
        "required": [
          "startsAt",
          "endsAt"
        ],
        "properties": {
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "unevaluatedProperties": {
          "not": {}
        }
      },
      "Booking": {
        "type": "object",
        "required": [
          "id",
          "meetingTypeId",
          "meetingTypeName",
          "startsAt",
          "endsAt",
          "durationMinutes",
          "timeZone"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "meetingTypeId": {
            "$ref": "#/components/schemas/MeetingTypeId"
          },
          "meetingTypeName": {
            "$ref": "#/components/schemas/MeetingTypeName"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "durationMinutes": {
            "$ref": "#/components/schemas/DurationMinutes"
          },
          "timeZone": {
            "type": "string",
            "enum": [
              "Europe/Moscow"
            ]
          }
        },
        "unevaluatedProperties": {
          "not": {}
        }
      },
      "BookingRequest": {
        "type": "object",
        "required": [
          "meetingTypeId",
          "startsAt"
        ],
        "properties": {
          "meetingTypeId": {
            "$ref": "#/components/schemas/MeetingTypeId"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "description": "RFC 3339 со смещением или Z; эквивалентные моменты равнозначны."
          }
        },
        "unevaluatedProperties": {
          "not": {}
        }
      },
      "DurationMinutes": {
        "type": "integer",
        "format": "int32",
        "minimum": 1,
        "maximum": 540
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "unevaluatedProperties": {
          "not": {}
        }
      },
      "MeetingType": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "durationMinutes"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/MeetingTypeId"
          },
          "name": {
            "$ref": "#/components/schemas/MeetingTypeName"
          },
          "description": {
            "$ref": "#/components/schemas/MeetingTypeDescription"
          },
          "durationMinutes": {
            "$ref": "#/components/schemas/DurationMinutes"
          }
        },
        "unevaluatedProperties": {
          "not": {}
        }
      },
      "MeetingTypeDescription": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "description": "Обычный текст с внутренними переносами; края очищаются от пробелов."
      },
      "MeetingTypeId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$"
      },
      "MeetingTypeList": {
        "type": "object",
        "required": [
          "serverTime",
          "items"
        ],
        "properties": {
          "serverTime": {
            "type": "string",
            "format": "date-time"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeetingType"
            }
          }
        },
        "unevaluatedProperties": {
          "not": {}
        }
      },
      "MeetingTypeName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "description": "Однострочный обычный текст; края очищаются от пробелов, длина в Unicode."
      }
    }
  }
}
